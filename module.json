{
  "id": "essence20-homebrew-starter",
  "title": "Essence20 Homebrew Starter",
  "description": "<p>A starting point for your own Essence20 content: compendiums already set up for Perks, Powers, Roles, Origins, gear, Zord and Transformer features and Threats, a worked example of each kind of field, and a guide - in Foundry - to making items that show up properly in the Compendium Browser and work through the Rules tab. House rules too: example rules a GM can switch on for every character, under Configure Settings. Copy it, rename it, and make it yours.</p>",
  "version": "1.1.0",
  "authors": [
    {
      "name": "talinthalas"
    }
  ],
  "compatibility": {
    "minimum": "14",
    "verified": "14.368"
  },
