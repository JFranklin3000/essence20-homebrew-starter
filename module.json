      {
        "id": "essence20",
        "type": "system",
        "compatibility": {
          "minimum": "6.0.4"
        }
      }
    ]
  },
  "esmodules": [
    "scripts/house-rules.mjs",
    "scripts/mask/house-rules.mjs",
    "scripts/mask/mask-tags.mjs"
  ],
