        "on": "equip",
        "items": [
          "item:mask"
        ],
        "when": [
          "self:wearingItem:item:mask"
        ],
        "message": "Take off the mask you are wearing first - one mask at a time."
      }
    ],
    "automation": {
      "status": "full",
      "notes": "<p>Sonar: for the scene, an Edge on Alertness and Athletics and a Swim speed of at least 30 ft. Speed uses per scene, only for the bonded wearer; +1 Toughness for any wearer.</p>"
