  "system": {
    "gearType": "military",
    "equipped": false,
    "quantity": 1,
    "description": "<p>Pumps out a bank of thick fog to hide the wearer - handy at the end of a race gone wrong.</p><p><em>Matt Trakker's mask.</em> Wearing it gives +1 Toughness. Its power works only for the agent it's bonded to, a number of times per scene equal to their Speed.</p>",
    "source": {
      "book": "M.A.S.K. (homebrew)",
      "page": 0
    },
    "rules": [
      {
        "type": "Use",
        "label": "Shroud",
        "when": [
          "self:maskBonded"
        ],
        "cost": {
          "action": "move"
        },
        "steps": [
          {
            "do": "applyCondition",
            "condition": "cover",
            "to": "self",
            "until": "endOfNextTurn"
          },
          {
            "do": "chat",
            "text": "{name} vanishes into a bank of fog."
          }
        ],
        "limit": {
          "per": "scene",
          "max": "@essence.speed",
          "key": "mask-shroud"
        }
      },
      {
        "type": "Defense",
        "label": "Mask helmet",
        "defense": "toughness",
        "amount": 1
      },
      {
        "type": "Veto",
        "on": "equip",
        "items": [
          "item:mask"
        ],
        "when": [
          "self:wearingItem:item:mask"
        ],
        "message": "Take off the mask you are wearing first - one mask at a time."
      }
    ],
    "automation": {
      "status": "partial",
      "notes": "<p>Gives the wearer Cover until the end of their next turn. Who else the fog hides is up to the GM. Speed uses per scene, only for the bonded wearer; +1 Toughness for any wearer.</p>"
    }
  },
