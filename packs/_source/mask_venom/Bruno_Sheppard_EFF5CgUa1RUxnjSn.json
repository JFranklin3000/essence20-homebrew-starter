    {
      "name": "Magna-Beam",
      "type": "gear",
      "img": "icons/magic/control/energy-stream-link-blue.webp",
      "system": {
        "gearType": "military",
        "equipped": true,
        "quantity": 1,
        "description": "<p>A magnetic mask that pulls, pushes or tears apart anything metal.</p><p><em>Bruno Sheppard's mask.</em> Bonded to the first agent who puts it on: for them, it gives +1 Toughness and its power works a number of times per scene equal to their Speed. One mask at a time.</p>",
        "source": {
          "book": "M.A.S.K. (homebrew)",
          "page": 0
        },
        "rules": [
          {
            "type": "Use",
            "label": "Magnetic Pull",
            "cost": {
              "action": "standard"
            },
            "steps": [
              {
                "do": "rollVsEach",
                "skill": "targeting",
                "defense": "toughness",
                "to": "target",
                "dataset": {
                  "maskPower": true
                },
                "onHit": [
                  {
                    "do": "applyCondition",
                    "condition": "restrained",
                    "to": "target",
                    "until": "endOfNextTurn"
                  }
                ]
              }
            ],
            "limit": {
              "per": "scene",
              "max": "@essence.speed",
              "key": "mask-magna-beam"
            }
          },
          {
            "type": "Defense",
            "label": "Mask helmet",
            "defense": "toughness",
            "amount": 1
          }
        ],
        "automation": {
          "status": "partial",
          "notes": "<p>Rolls Targeting against the target's Toughness; a hit pins it Restrained until the end of its next turn. Tearing apart metal objects is up to the GM. Speed uses per scene and +1 Toughness, only for the bonded wearer (Power Gear: bonded, mask slot).</p>"
        },
