    {
      "name": "Whip",
      "type": "gear",
      "img": "icons/magic/lightning/bolt-forked-large-magenta.webp",
      "system": {
        "gearType": "military",
        "equipped": true,
        "quantity": 1,
        "description": "<p>Lashes out with long, crackling strands of electric energy.</p><p><em>Vanessa Warfield's mask.</em> Bonded to the first agent who puts it on: for them, it gives +1 Toughness and its power works a number of times per scene equal to their Speed. One mask at a time.</p>",
        "source": {
          "book": "M.A.S.K. (homebrew)",
          "page": 0
        },
        "rules": [
          {
            "type": "Use",
            "label": "Energy Whip",
            "cost": {
              "action": "standard"
            },
            "steps": [
              {
                "do": "rollVsEach",
                "skill": "targeting",
                "defense": "evasion",
                "to": "target",
                "dataset": {
                  "maskPower": true
                },
                "damage": {
                  "value": 2,
                  "type": "electric"
                },
                "onDouble": [
                  {
                    "do": "applyCondition",
                    "condition": "grappled",
                    "to": "target",
                    "until": "endOfNextTurn"
                  }
                ]
              }
            ],
            "limit": {
              "per": "scene",
              "max": "@essence.speed",
              "key": "mask-whip"
            }
          },
          {
            "type": "Defense",
            "label": "Mask helmet",
            "defense": "toughness",
            "amount": 1
          }
        ],
        "automation": {
          "status": "full",
          "notes": "<p>Rolls against the targets and posts Apply Damage buttons (x degrees of success) and any Condition on a hit. A hit of two degrees or more also wraps the target up (Grappled). Speed uses per scene and +1 Toughness, only for the bonded wearer (Power Gear: bonded, mask slot).</p>"
        },
        "originalId": "",
