    {
      "name": "Quick Disguise",
      "type": "perk",
      "img": "icons/equipment/head/mask-carved-wood-brown.webp",
      "system": {
        "type": "origin",
        "description": "<p>A wig, a uniform and a new walk, and nobody looks twice. Without a mask on, your Deception and Infiltration Tests have Edge - a M.A.S.K. helmet is not much of a disguise.</p><p><em>M.A.S.K. homebrew.</em></p>",
        "source": {
          "book": "M.A.S.K. (homebrew)",
          "page": 0
        },
        "selectionLimit": 1,
        "rules": [
          {
            "type": "RollModifier",
            "label": "Quick Disguise",
            "edge": true,
            "when": [
              {
                "any": [
                  "skill:deception",
                  "skill:infiltration"
                ]
              },
              "not:self:slotEquipped:mask"
            ]
          }
        ],
        "automation": {
          "status": "full",
          "notes": "<p>Automatic: while you wear no mask, Deception and Infiltration Tests have Edge.</p>"
