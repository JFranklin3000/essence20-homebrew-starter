    "size": "extended",
    "notes": "<p>A long-haul semi truck. Its armor plates slide up into a rolling fortress and mobile command center, with an ATV tucked in the back.</p><p><em>Matt Trakker's vehicle.</em> Its weapons come out in Strike Mode. Stats are homebrew.</p>"
  },
  "items": [
    {
      "name": "Strike Mode: Fortress",
      "type": "upgrade",
      "img": "icons/svg/castle.svg",
      "system": {
        "type": "vehicle",
        "description": "<p>Armor plates slam into place over the cab and trailer.</p>",
        "source": {
          "book": "M.A.S.K. (homebrew)",
          "page": 0
        },
        "rules": [
          {
            "type": "Use",
            "label": "Strike Mode!",
            "when": [
              "not:self:marked:strikeMode"
            ],
            "cost": {
              "action": "free"
            },
            "steps": [
              {
                "do": "mark",
                "key": "strikeMode"
              },
              {
                "do": "chat",
                "text": "{name} locks down into an armored fortress!"
              }
            ]
          },
          {
            "type": "Use",
            "label": "Civilian Mode",
            "when": [
              "self:marked:strikeMode"
            ],
            "cost": {
              "action": "free"
            },
            "steps": [
              {
                "do": "unmark",
                "key": "strikeMode"
              },
              {
                "do": "chat",
                "text": "{name} converts back to Civilian Mode."
              }
            ]
          },
          {
            "type": "Defense",
            "label": "Fortress armor",
            "defense": "toughness",
            "amount": 3,
            "when": [
              "self:marked:strikeMode"
            ]
          }
        ],
        "automation": {
          "status": "full",
          "notes": "<p>Strike Mode! marks the vehicle (until Civilian Mode clears it); the rules listed here hold only while it is marked. Fortress: +3 Toughness.</p>"
        }
      },
