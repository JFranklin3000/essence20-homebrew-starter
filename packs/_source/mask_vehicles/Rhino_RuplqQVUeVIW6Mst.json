    {
      "name": "Ultra-Flash Floodlights",
      "type": "upgrade",
      "img": "icons/magic/light/explosion-star-glow-yellow.webp",
      "system": {
        "type": "vehicle",
        "description": "<p>With someone aboard wearing Ultra-Flash, the Rhino's floodlights carry its blinding burst.</p>",
        "source": {
          "book": "M.A.S.K. (homebrew)",
          "page": 0
        },
        "rules": [
          {
            "type": "Use",
            "label": "Flash Floodlights",
            "when": [
              "self:marked:strikeMode",
              "self:crewWearing:Ultra-Flash"
            ],
            "cost": {
              "action": "standard"
            },
            "limit": {
              "per": "scene",
              "max": 1
            },
            "steps": [
              {
                "do": "rollVsEach",
                "skill": "targeting",
                "defense": "evasion",
                "to": "targets",
                "onHit": [
                  {
                    "do": "applyCondition",
                    "condition": "blinded",
                    "to": "target",
                    "until": "endOfNextTurn"
                  }
                ]
              }
            ]
          }
        ],
        "automation": {
          "status": "full",
          "notes": "<p>Strike Mode, with someone aboard wearing a working Ultra-Flash mask: once per scene, Targeting against each target's Evasion; a hit Blinds until the end of its next turn.</p>"
        }
