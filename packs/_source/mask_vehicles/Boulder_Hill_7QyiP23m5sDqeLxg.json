                "hidden": false
              },
              {
                "do": "placeBeside",
                "to": "target"
              },
              {
                "do": "chat",
                "text": "{name} deploys the vehicle!"
              }
            ]
          },
          {
            "type": "Use",
            "label": "Dock vehicle",
            "cost": {
              "action": "move"
            },
            "steps": [
              {
                "do": "hideTokens",
                "to": "target",
                "hidden": true
              },
              {
                "do": "chat",
                "text": "The vehicle docks with {name}."
              }
            ]
          }
        ],
        "automation": {
          "status": "partial",
          "notes": "<p>Keep a stored vehicle's token hidden on the scene. Target it, then Deploy: it rolls out beside the base. Dock hides it again.</p>"
